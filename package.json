{
  "name": "@local/dsh-code-live",
  "version": "1.0.0",
  "private": true,
  "description": "Live code-change panel in the right Sidebar: streams the file a write/edit call is producing, boxed on the region it replaces.",
  "icon": "icon.png",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/wechat-qr.jpg",
    "assets/livecode-demo.gif",
    "README.md",
    "README.zh.md",
    "HANDOFF.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT"
}
